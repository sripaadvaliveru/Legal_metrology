{
  "expo": {
    "name": "Legal Metrology",
    "slug": "legal-metrology-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1f2937"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legalmetrology.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f2937"
      },
      "package": "com.legalmetrology.mobile",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.7:8080/api"
    }
  }
}
