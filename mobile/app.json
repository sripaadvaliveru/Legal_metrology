{
  "expo": {
    "name": "Legal Metrology",
    "slug": "legal-metrology-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legalmetrology.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f2937"
      },
      "package": "com.legalmetrology.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f2937",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.6:8080/api",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
