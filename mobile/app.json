{
  "expo": {
    "name": "Legal Metrology",
    "slug": "legal-metrology-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1f2937"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legalmetrology.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f2937"
      },
      "package": "com.legalmetrology.mobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "apiBaseUrl": "https://legalmetrology-production-e7ae.up.railway.app/api",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
